#!/bin/sh

set -eu

GADGET_DIR=/sys/kernel/config/usb_gadget/y700
ROLE_PATH=/sys/class/usb_role/a600000.usb-role-switch/role
UDC_NAME=a600000.usb
USB_INTERFACE=usb0
USB_ADDRESS=172.31.187.1/30

wait_for_path() {
  path=$1
  timeout=${2:-30}
  elapsed=0

  while [ ! -e "$path" ]; do
    if [ "$elapsed" -ge "$timeout" ]; then
      echo "timed out waiting for $path" >&2
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
}

unbind_gadget() {
  if [ -e "$GADGET_DIR/UDC" ] && [ -n "$(cat "$GADGET_DIR/UDC" 2>/dev/null)" ]; then
    printf '\n' > "$GADGET_DIR/UDC"
  fi
}

remove_gadget() {
  [ -d "$GADGET_DIR" ] || return 0

  unbind_gadget
  rm -f "$GADGET_DIR/configs/c.1/ecm.usb0"
  rmdir "$GADGET_DIR/functions/ecm.usb0" 2>/dev/null || true
  rmdir "$GADGET_DIR/configs/c.1/strings/0x409" 2>/dev/null || true
  rmdir "$GADGET_DIR/configs/c.1" 2>/dev/null || true
  rmdir "$GADGET_DIR/strings/0x409" 2>/dev/null || true
  rmdir "$GADGET_DIR" 2>/dev/null || true
}

start_gadget() {
  modprobe libcomposite
  wait_for_path "$ROLE_PATH"

  if [ "$(cat "$ROLE_PATH")" != device ]; then
    printf device > "$ROLE_PATH"
  fi

  wait_for_path "/sys/class/udc/$UDC_NAME"
  remove_gadget

  mkdir -p "$GADGET_DIR"
  printf 0x1d6b > "$GADGET_DIR/idVendor"
  printf 0x0104 > "$GADGET_DIR/idProduct"
  printf 0x0200 > "$GADGET_DIR/bcdUSB"
  printf 0x0100 > "$GADGET_DIR/bcdDevice"

  mkdir -p "$GADGET_DIR/strings/0x409"
  printf Y700USB001 > "$GADGET_DIR/strings/0x409/serialnumber"
  printf Lenovo > "$GADGET_DIR/strings/0x409/manufacturer"
  printf 'Y700 Linux USB Debug' > "$GADGET_DIR/strings/0x409/product"

  mkdir -p "$GADGET_DIR/configs/c.1/strings/0x409"
  printf 'ECM debug network' > "$GADGET_DIR/configs/c.1/strings/0x409/configuration"

  mkdir -p "$GADGET_DIR/functions/ecm.usb0"
  printf 02:70:00:00:00:01 > "$GADGET_DIR/functions/ecm.usb0/dev_addr"
  printf 02:70:00:00:00:02 > "$GADGET_DIR/functions/ecm.usb0/host_addr"
  ln -s "$GADGET_DIR/functions/ecm.usb0" "$GADGET_DIR/configs/c.1/ecm.usb0"
  printf '%s' "$UDC_NAME" > "$GADGET_DIR/UDC"

  wait_for_path "/sys/class/net/$USB_INTERFACE"
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device set "$USB_INTERFACE" managed no >/dev/null 2>&1 || true
  fi
  ip address replace "$USB_ADDRESS" dev "$USB_INTERFACE"
  ip link set "$USB_INTERFACE" up
}

stop_gadget() {
  remove_gadget

  if [ -e "$ROLE_PATH" ] && [ "$(cat "$ROLE_PATH")" != host ]; then
    printf host > "$ROLE_PATH"
  fi
}

case "${1:-}" in
  start)
    start_gadget
    ;;
  stop)
    stop_gadget
    ;;
  restart)
    stop_gadget
    start_gadget
    ;;
  *)
    echo "usage: $0 {start|stop|restart}" >&2
    exit 2
    ;;
esac
